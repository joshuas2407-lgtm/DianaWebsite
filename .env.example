# Owner password for CMS editing (choose a strong password)
OWNER_PASSWORD=change-me-to-a-secure-password

# Random secret for session cookies (generate with: openssl rand -base64 32)
OWNER_SESSION_SECRET=change-me-to-a-long-random-string

# Web server port (default 3000)
PORT=3000

# Vercel Blob token. Set automatically on Vercel once a Blob store is connected.
# Leave unset locally to save edits to data/ and public/uploads/ instead.
# BLOB_READ_WRITE_TOKEN=
